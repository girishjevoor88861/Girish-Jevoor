# CivicAI Environment Configuration Template

# Server Settings
CIVICAI_HOST=0.0.0.0
CIVICAI_PORT=8000

# Security & Sessions
CIVICAI_SECRET_KEY=civicai_super_secret_jwt_key_2026_enterprise_civic_platform
CIVICAI_SESSION_EXPIRE_HOURS=72

# Database Settings (Default: SQLite 3)
CIVICAI_DATABASE_PATH=backend/civicai.db

# File Storage
CIVICAI_UPLOAD_DIR=uploads/

# Optional External Cloud Services (When scaling beyond local deployment)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AWS_S3_BUCKET=civicai-evidence-storage
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-token
